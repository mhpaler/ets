# ========================================
# ETS Environment Configuration
# ========================================
# Copy this to .env and uncomment what you need
# Most values have smart defaults in the config package
# ========================================

# ========================================
# SECTION 1: Monorepo & Development Tools
# ========================================
# Only needed for releasing packages
# GITHUB_TOKEN=ghp_xxxxx

# ========================================
# SECTION 2: Network Selection
# ========================================
# The start-stack.sh script sets this for you
# Or set manually: local, staging, production
# ENVIRONMENT=local

# ========================================
# SECTION 3: Blockchain Access
# ========================================
# Your Alchemy API key (used by all networks)
# Required for blockchain interactions in the UI
# ALCHEMY_API_KEY=your-key-here

# ========================================
# SECTION 4: Wallets (Keep in .env.local!)
# ========================================
# Local development (defaults to test mnemonic)
# LOCAL_MNEMONIC="test test test test test test test test test test test junk"

# Staging (Base Sepolia) - needs testnet funds
# STAGING_MNEMONIC="your twelve word staging mnemonic"

# Production (Base Mainnet) - NEVER commit!
# PRODUCTION_MNEMONIC="your production mnemonic"

# ========================================
# SECTION 5: Optional Services
# ========================================
# Only if using Temporal Cloud
# TEMPORAL_API_KEY=
# TEMPORAL_NAMESPACE=
# TEMPORAL_SERVER_URL=

# Contract verification (optional)
# BASESCAN_API_KEY=your-key

# ========================================
# Quick Start Examples
# ========================================
# For local development - you need NOTHING! Just run:
#   ./scripts/start-stack.sh
#
# For staging (Base Sepolia) - you need:
#   ALCHEMY_API_KEY=xxx
#   STAGING_MNEMONIC="xxx xxx xxx..."
#   Then run: ./scripts/start-stack.sh --network staging
#
# For production monitoring - you need:
#   ALCHEMY_API_KEY=xxx
#   PRODUCTION_MNEMONIC="xxx xxx xxx..."
#   TEMPORAL_CLOUD_URL=xxx
#   Then run: ./scripts/start-stack.sh --network production --services temporal