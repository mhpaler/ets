{
  "name": "@ethereum-tag-service/ets-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command-line interface for interacting with ETS smart contracts",
  "author": "Ethereum Tag Service <team@ets.xyz>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ets": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ets": "tsx src/index.ts"
  },
  "dependencies": {
    "@ethereum-tag-service/contracts": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "ora": "^8.0.1",
    "viem": "^2.36.0"
  },
  "devDependencies": {
    "@ethereum-tag-service/tsconfig": "workspace:*",
    "@types/node": "^22.18.0",
    "tsup": "^8.2.3",
    "tsx": "^4.7.1",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
