# Environment Configuration
NODE_ENV=staging                    # staging | production | development
ALCHEMY_API_KEY=your-alchemy-api-key

# Chain Configuration (Base Sepolia for all environments currently)
CHAIN_ID=84532

# Off-chain API Configuration  
OFFCHAIN_API_URL=http://localhost:3000
OFFCHAIN_API_KEY=your-api-key

# Logging
LOG_LEVEL=info

# Optional: Manual overrides (auto-resolved from environment if not provided)
# ETS_TOKEN_ADDRESS=0x...
# SUBGRAPH_URL=https://api.studio.thegraph.com/query/...