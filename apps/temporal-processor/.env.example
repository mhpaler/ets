# Temporal Configuration
TEMPORAL_SERVER_URL=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ets-workflows
TEMPORAL_WORKER_ID=ets-worker-1

# Blockchain Configuration
# RPC_URL=http://localhost:8545  # Optional - uses workspace utility by default
CHAIN_ID=31337
# Contract addresses auto-configured from @ethereum-tag-service/contracts workspace package

# Private key for on-chain updates (EVENT_PROCESSOR_ROLE)
PRIVATE_KEY=0x...

# External Services
OFFCHAIN_API_URL=http://localhost:3000
ARWEAVE_GATEWAY=https://arweave.net

# Worker Configuration
MAX_CONCURRENT_ACTIVITIES=10
MAX_CONCURRENT_WORKFLOWS=100

# Environment
NODE_ENV=development
LOG_LEVEL=info