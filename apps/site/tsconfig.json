{
  "compilerOptions": {
    "jsx": "preserve",
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "Node16",
    "moduleResolution": "nodenext", // Updated from "node16" to "nodenext"
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"],
      "@ethereum-tag-service/contracts": [
        "../../packages/contracts/dist"
      ],
      "@ethereum-tag-service/contracts/*": [
        "../../packages/contracts/dist/*"
      ],
      "@ethereum-tag-service/sdk-core": [
        "../../packages/sdk-core/dist"
      ],
      "@ethereum-tag-service/sdk-core/*": [
        "../../packages/sdk-core/dist/*"
      ],
      "@ethereum-tag-service/sdk-react-hooks": [
        "../../packages/sdk-react-hooks/dist"
      ],
      "@ethereum-tag-service/sdk-react-hooks/*": [
        "../../packages/sdk-react-hooks/dist/*"
      ],
      "@ethereum-tag-service/subgraph-endpoints": [
        "../../packages/subgraph-endpoints/dist"
      ],
      "@ethereum-tag-service/subgraph-endpoints/*": [
        "../../packages/subgraph-endpoints/dist/*"
      ]
    },
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "pages/**/*.mdx",
    "components/**/*.ts",
    "components/**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.js",
    "postcss.config.js",
    "tailwind.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
