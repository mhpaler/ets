{
  "name": "@ethereum-tag-service/temporal-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ETS Temporal Workflow Processor - Handles blockchain event processing with Temporal workflows",
  "author": "Ethereum Tag Service <team@ets.xyz>",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.workflows.json",
    "dev": "tsx src/index.ts",
    "dev:watch": "bun --watch src/index.ts",
    "dev:basesepolia": "cp .env.basesepolia .env && tsx src/worker.ts",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "worker:basesepolia": "cp .env.basesepolia .env && tsx src/worker.ts",
    "workflow:start": "temporal workflow start --type TargetEnrichmentWorkflow --task-queue ets-workflows --workflow-id test-workflow-1",
    "test": "jest",
    "test:metadata-extraction": "cd ../.. && jest test/integration/metadata-extraction.test.ts --testTimeout=30000",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ethereum-tag-service/config": "workspace:*",
    "@ethereum-tag-service/contracts": "workspace:*",
    "@ethereum-tag-service/subgraph-endpoints": "workspace:*",
    "@scure/bip32": "^2.0.0",
    "@scure/bip39": "^2.0.0",
    "@temporalio/activity": "^1.11.3",
    "@temporalio/client": "^1.11.3",
    "@temporalio/worker": "^1.11.3",
    "@temporalio/workflow": "^1.11.3",
    "@zoralabs/coins-sdk": "^0.3.2",
    "axios": "^1.7.9",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "unfurl.js": "^6.4.0",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@swc/core": "^1.9.4",
    "@swc/helpers": "^0.5.15",
    "@temporalio/testing": "^1.11.3",
    "@types/chai": "^5.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "chai": "^6.0.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  },
  "license": "ISC"
}
