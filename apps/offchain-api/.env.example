# API Configuration
PORT=4000
NODE_ENV=development

# Set to 'true' to use mock Arweave (no actual uploads)
MOCK_ARWEAVE=true
# Set to 'true' to enhance mock metadata
ENHANCE_MOCK_METADATA=true

# Arweave Configuration - For content storage
ARWEAVE_JWK_PATH=./arweave-keyfile.json
ARWEAVE_GATEWAY=https://arweave.net

# Alchemy API Key - Used by sdk-core for RPC connections
ALCHEMY_API_KEY=

# Custom RPC URLs (Optional) - Will be used by sdk-core if provided
# These are fallbacks if Alchemy is unavailable or fails
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# TAG Coins Configuration
# ETS EOA Private Key for coin creation (REQUIRED)
ETS_EOA_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Chain configuration
CHAIN_ID=84532

# API Security
INTERNAL_API_KEY=super-secret-internal-key-for-oracle
ORACLE_API_KEY=super-secret-oracle-key
ORACLE_ALLOWED_IPS=127.0.0.1,10.0.0.0/8

# Metadata Service
METADATA_MOCK_MODE=true
METADATA_API_URL=http://localhost:3000/api/metadata
