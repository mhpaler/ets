# ========================================
# Contracts Package Configuration
# ========================================
# This package now uses @ethereum-tag-service/config
# Configure environments in root .env files
# ========================================
#
# The config package handles:
# - Network configuration (RPC URLs, chain IDs)
# - Wallet mnemonics (for deployments)
# - Environment detection (local/staging/production)
#
# For environment configuration, use root .env files:
# - .env.local (for local overrides, gitignored)
# - .env.staging (for staging environment)
# - .env.production (for production environment)
#
# ========================================
# Package-Specific Configuration
# ========================================
# Only contract verification settings remain here:

# Basescan API for contract verification (optional)
# Get your API key from https://basescan.org
BASESCAN_API_KEY=your-basescan-api-key

# Enable automatic contract verification after deployment
VERIFY_ON_DEPLOY=false