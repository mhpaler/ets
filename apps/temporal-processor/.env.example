# Temporal Processor Environment Configuration

# ========================================
# Environment Settings
# ========================================
NODE_ENV=development
LOG_LEVEL=info

# ========================================
# Blockchain Configuration  
# ========================================
# Chain ID: 31337 (localhost), 84532 (Base Sepolia), 8453 (Base Mainnet)
CHAIN_ID=31337

# RPC URL (optional - uses Alchemy by default based on CHAIN_ID)
# RPC_URL=https://sepolia.base.org

# Alchemy API Key (recommended for staging/production)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ========================================
# Temporal Configuration
# ========================================
# For local development (Docker Compose)
TEMPORAL_SERVER_URL=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ets-workflows
TEMPORAL_WORKER_ID=ets-worker-local

# For Temporal Cloud (staging/production)
# TEMPORAL_SERVER_URL=your-namespace.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=your-namespace.account-id
# TEMPORAL_TASK_QUEUE=ets-workflows
# TEMPORAL_CLIENT_CERT=base64_encoded_client_certificate
# TEMPORAL_CLIENT_KEY=base64_encoded_client_private_key

# ========================================
# External Services
# ========================================
# Offchain API URL
OFFCHAIN_API_URL=http://localhost:3000

# Arweave Gateway
ARWEAVE_GATEWAY=https://arweave.net

# ========================================
# Worker Configuration
# ========================================
MAX_CONCURRENT_ACTIVITIES=10
MAX_CONCURRENT_WORKFLOWS=100

# ========================================
# Production Only Settings
# ========================================
# Uncomment for production deployments
# SENTRY_DSN=your_sentry_dsn_here
# POSTGRES_PASSWORD=secure_password_here

# ========================================
# Environment Examples
# ========================================

# LOCAL DEVELOPMENT:
# NODE_ENV=development
# CHAIN_ID=31337
# TEMPORAL_SERVER_URL=localhost:7233

# STAGING (Base Sepolia + Temporal Cloud):
# NODE_ENV=staging
# CHAIN_ID=84532
# TEMPORAL_SERVER_URL=staging-namespace.tmprl.cloud:7233
# TEMPORAL_CLIENT_CERT=<base64-cert>
# TEMPORAL_CLIENT_KEY=<base64-key>
# ALCHEMY_API_KEY=<your-key>

# PRODUCTION (Base Mainnet + Temporal Cloud):
# NODE_ENV=production
# CHAIN_ID=8453
# TEMPORAL_SERVER_URL=prod-namespace.tmprl.cloud:7233
# TEMPORAL_CLIENT_CERT=<base64-cert>
# TEMPORAL_CLIENT_KEY=<base64-key>
# ALCHEMY_API_KEY=<your-key>
# LOG_LEVEL=warn