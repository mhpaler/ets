{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node16",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "outDir": "./dist",
    "declaration": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "hardhat.config.ts", "scripts/**/*.ts", "test/**/*.ts", "tasks/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "files": ["hardhat.config.ts"]
}
