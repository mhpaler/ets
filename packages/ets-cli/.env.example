# ETS CLI Configuration

# Required: Either PRIVATE_KEY or MNEMONIC must be set
# Option 1: Private key (without 0x prefix)
PRIVATE_KEY=

# Option 2: Mnemonic phrase
MNEMONIC=

# Optional: Account index when using mnemonic (default: 0)
ACCOUNT_INDEX=0

# Network configuration
NETWORK=localhost

# RPC URLs (optional - defaults provided for common networks)
RPC_URL_LOCALHOST=http://127.0.0.1:8545
RPC_URL_BASESEPOLIA=https://sepolia.base.org
RPC_URL_BASE=https://mainnet.base.org

# Optional: Enable debug output
DEBUG=false