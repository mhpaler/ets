# Temporal Processor Environment Configuration - BASE SEPOLIA

# ========================================
# Environment Settings
# ========================================
NODE_ENV=staging
LOG_LEVEL=info

# ========================================
# Blockchain Configuration
# ========================================
# Chain ID: 84532 (Base Sepolia)
CHAIN_ID=84532

# RPC URL for Base Sepolia (using Alchemy for event filter support)
RPC_URL=https://base-sepolia.g.alchemy.com/v2/TjjzoNYlIqWqZxcoufe60bhVbARhkxYX

# Alchemy API Key (optional, fallback to public RPC)
ALCHEMY_API_KEY=TjjzoNYlIqWqZxcoufe60bhVbARhkxYX

# ========================================
# Temporal Configuration
# ========================================
# Local Temporal Server for debugging staging contracts
TEMPORAL_SERVER_URL=localhost:7233
TEMPORAL_NAMESPACE=default
# Using location-environment task queue pattern
TEMPORAL_TASK_QUEUE=ets-workflows-local-staging
TEMPORAL_WORKER_ID=ets-worker-local-staging

# ========================================
# External Services
# ========================================
# Offchain API URL (local for now)
OFFCHAIN_API_URL=http://localhost:3000

# Arweave Gateway
ARWEAVE_GATEWAY=https://arweave.net

# ========================================
# Worker Configuration
# ========================================
MAX_CONCURRENT_ACTIVITIES=10
MAX_CONCURRENT_WORKFLOWS=100

# ========================================
# HD Wallet Configuration
# ========================================
# Using HD wallet with position-based roles:
# Position 0: ETSAdmin
# Position 1: ETSPlatform
# Position 2: ETSEventProcessor
# Position 3: ETSZora
# We need position 2 for EVENT_PROCESSOR_ROLE
MNEMONIC=three toddler enjoy good finish there bracket home machine habit hat useful
HD_WALLET_POSITION=2