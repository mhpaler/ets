# ========================================
# ETS Contracts Configuration
# ========================================
# Copy this file to .env.local for your environment
# ========================================

# Network Configuration
# ========================================

# Local Development (Hardhat Network)
# Default mnemonic for local development
LOCAL_MNEMONIC="test test test test test test test test test test test junk"

# Staging Environment (Base Sepolia)
# Set your staging mnemonic for Base Sepolia deployments
STAGING_MNEMONIC="your staging mnemonic here"
STAGING_RPC_URL="https://base-sepolia.g.alchemy.com/v2/your-alchemy-api-key"

# Production Environment (Base Mainnet)
# Set your production mnemonic for Base Mainnet deployments
PRODUCTION_MNEMONIC="your production mnemonic here"
PRODUCTION_RPC_URL="https://base-mainnet.g.alchemy.com/v2/your-alchemy-api-key"

# Contract Verification
# ========================================

# Basescan API key for contract verification (optional)
# Get your API key from https://basescan.org
BASESCAN_API_KEY=your-basescan-api-key

# Enable automatic contract verification after deployment
VERIFY_ON_DEPLOY=false

# Alchemy API Key (optional, for default RPC endpoints)
# If not set, will use default public endpoints
ALCHEMY_API_KEY=your-alchemy-api-key